// The database schema. After changing it, create a migration: npm run db:migrate -- --name <what-changed>
// (docs: https://pris.ly/d/prisma-schema)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model UserSession {
  ID                Int                   @id @default(autoincrement())
  // SHA-256 of the session token; the token itself only lives in the browser's httpOnly cookie
  Token             String                @unique
  Expires           DateTime
  User              User                  @relation(name: "UserSessions", fields: [UserID], references: [ID])
  UserID            Int

  @@index([UserID])
}

model User {
  ID                Int                   @id @default(autoincrement())
  UserName          String                @unique
  FirstName         String
  LastName          String
  // "scrypt$N$r$p$salt$hash"; accounts made before scrypt keep a SHA-256 hash in PasswordHash with its salt in
  // PasswordSalt until their next sign-in, which upgrades them (PasswordSalt is then null)
  PasswordHash      String
  PasswordSalt      String?
  Enabled           Boolean
  Position          String
  WorkStartTime     DateTime?
  UserType          UserType
  Deleted           Boolean               @default(false)
  CurrentTask       Task?                 @relation(name: "CurrentTask", fields: [CurrentTaskID], references: [ID])
  CurrentTaskID     Int?
  // the worker's manager (vedoucí)
  Manager           User?                 @relation(name: "UserManager", fields: [ManagerID], references: [ID])
  ManagerID         Int?
  Subordinates      User[]                @relation(name: "UserManager")
  Requests          MaterialRequest[]     @relation(name: "Creator")
  AcceptedRequests  MaterialRequest[]     @relation(name: "Acceptor")
  Sessions          UserSession[]         @relation(name: "UserSessions")
  OwnedProjects     Project[]             @relation(name: "ProjectOwner")
  OwnedTasks        Task[]                @relation(name: "TaskOwner")
  Member            User_Project[]        @relation(name: "UserMember")
  MaterialEvent     MaterialEvent[]       @relation(name: "Event_User")
  UserTaskTime      UserTaskTime[]        @relation(name: "TaskTime_User")
  User_Task         User_Task[]           @relation(name: "UserTask_User")
  WorkTime          WorkTime[]            @relation(name: "HasTime")
  PrivateTask       PrivateTask[]         @relation(name: "HasPrivateTask")
  UploadedFiles     TaskFile[]            @relation(name: "FileUploader")
  ResponsibleMachines Machine[]           @relation(name: "MachineResponsible")
  MachineServices   MachineService[]      @relation(name: "MachineServiceCreator")
  MachineFiles      MachineFile[]         @relation(name: "MachineFileUploader")
  SentMessages      ChatMessage[]         @relation(name: "ChatSender")
  ReceivedMessages  ChatMessage[]         @relation(name: "ChatRecipient")
  ChatReads         ChatRead[]            @relation(name: "ChatReader")
  ChatReadsAsPartner ChatRead[]           @relation(name: "ChatReadPartner")
}

enum UserType {
  ADMIN
  MANAGER
  USER
}

model PrivateTask {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String
  FinishDate        DateTime
  Finished          Boolean
  User              User                  @relation(name: "HasPrivateTask", fields: [UserID], references: [ID])
  UserID            Int
}

model WorkTime {
  ID                Int                   @id @default(autoincrement())
  StartTime         DateTime
  StopTime          DateTime?
  User              User                  @relation(name: "HasTime", fields: [UserID], references: [ID])
  UserID            Int
}

model UserTaskTime {
  ID                Int                   @id @default(autoincrement())
  StartTime         DateTime
  StopTime          DateTime?
  User              User                  @relation(name: "TaskTime_User", fields: [UserID], references: [ID])
  UserID            Int
  Task              Task                  @relation(name: "TaskTime_Task", fields: [TaskID], references: [ID])
  TaskID            Int
}

model User_Task {
  ID                Int                   @id @default(autoincrement())
  User              User                  @relation(name: "UserTask_User", fields: [UserID], references: [ID])
  UserID            Int
  Task              Task                  @relation(name: "UserTask_Task", fields: [TaskID], references: [ID])
  TaskID            Int
}

model Task {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String?
  FinishDate        DateTime
  Finished          Boolean
  DurationHours     Int                   @default(0)
  DurationMinutes   Int                   @default(0)
  XPosition         Float
  YPosition         Float
  Size              Int
  Owner             User                  @relation(name: "TaskOwner", fields: [OwnerID], references: [ID])
  OwnerID           Int
  Project           Project               @relation(name: "Tasks", fields: [ProjectID], references: [ID])
  ProjectID         Int
  Machine           Machine?              @relation(name: "AssignedMachines", fields: [MachineID], references: [ID])
  MachineID         Int?
  Predecessors      TaskDependency[]      @relation(name: "Predecessor")
  Successors        TaskDependency[]      @relation(name: "Successor")
  WorkingUsers      User[]                @relation(name: "CurrentTask")
  MaterialEvent     MaterialEvent[]       @relation(name: "Event_Task")
  MaterialRequest   MaterialRequest[]     @relation(name: "Request_Task")
  UserTaskTime      UserTaskTime[]        @relation(name: "TaskTime_Task")
  User_Task         User_Task[]           @relation(name: "UserTask_Task")
  Files             TaskFile[]            @relation(name: "TaskFiles")
}

// Who uploaded a task's input or output file and when (the file itself lives on disk, see DATA_DIR in tasks.ts).
// Files from before this table have no row; uploading a file with the same name again updates its row.
model TaskFile {
  ID                Int                   @id @default(autoincrement())
  Task              Task                  @relation(name: "TaskFiles", fields: [TaskID], references: [ID])
  TaskID            Int
  Kind              TaskFileKind
  Name              String
  UploadedAt        DateTime              @default(now())
  UploadedBy        User?                 @relation(name: "FileUploader", fields: [UploadedByID], references: [ID], onDelete: SetNull)
  UploadedByID      Int?

  @@unique([TaskID, Kind, Name])
}

enum TaskFileKind {
  INPUT
  OUTPUT
}

model TaskDependency {
  ID                Int                   @id @default(autoincrement())
  Project           Project               @relation(name: "Dependencies", fields: [ProjectID], references: [ID])
  ProjectID         Int
  Predecessor       Task                  @relation(name: "Predecessor", fields: [PredecessorID], references: [ID])
  PredecessorID     Int
  Successor         Task                  @relation(name: "Successor", fields: [SuccessorID], references: [ID])
  SuccessorID       Int
}

model Machine {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String?
  Deleted           Boolean               @default(false)
  Task              Task[]                @relation(name: "AssignedMachines")
  // the person who looks after the machine (its services, documentation)
  Responsible       User?                 @relation(name: "MachineResponsible", fields: [ResponsibleID], references: [ID], onDelete: SetNull)
  ResponsibleID     Int?
  Services          MachineService[]      @relation(name: "MachineServices")
  Files             MachineFile[]         @relation(name: "MachineFiles")
}

// A service of a machine: done (Done, on Date) or planned for Date
model MachineService {
  ID                Int                   @id @default(autoincrement())
  Machine           Machine               @relation(name: "MachineServices", fields: [MachineID], references: [ID])
  MachineID         Int
  Date              DateTime
  Done              Boolean               @default(false)
  Title             String
  Note              String?
  CreatedAt         DateTime              @default(now())
  CreatedBy         User?                 @relation(name: "MachineServiceCreator", fields: [CreatedByID], references: [ID], onDelete: SetNull)
  CreatedByID       Int?
}

// Who uploaded each machine file (documentation, manuals...) and when; the files are in <DATA_DIR>/machines/<machine>
model MachineFile {
  ID                Int                   @id @default(autoincrement())
  Machine           Machine               @relation(name: "MachineFiles", fields: [MachineID], references: [ID])
  MachineID         Int
  Name              String
  UploadedAt        DateTime              @default(now())
  UploadedBy        User?                 @relation(name: "MachineFileUploader", fields: [UploadedByID], references: [ID], onDelete: SetNull)
  UploadedByID      Int?

  @@unique([MachineID, Name])
}

model MaterialRequest {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String?
  Count             Int
  Price             Int
  AddedDate         DateTime
  NeededDate        DateTime?
  AcceptedDate      DateTime?
  AcceptedBy        User?                 @relation(name: "Acceptor", fields: [AcceptedByID], references: [ID])
  AcceptedByID      Int?
  TargetTask        Task?                 @relation(name: "Request_Task", fields: [TargetTaskID], references: [ID])
  TargetTaskID      Int?
  TargetUser        User                  @relation(name: "Creator", fields: [TargetUserID], references: [ID])
  TargetUserID      Int
}

model MaterialEvent {
  ID                Int                   @id @default(autoincrement())
  Count             Int
  TargetTask        Task?                 @relation(name: "Event_Task", fields: [TargetTaskID], references: [ID])
  TargetTaskID      Int?
  TargetUser        User?                 @relation(name: "Event_User", fields: [TargetUserID], references: [ID])
  TargetUserID      Int?
  Material          Material              @relation(name: "Event_Material", fields: [MaterialID], references: [ID])
  MaterialID        Int
  EventType         EventType
}

enum EventType {
  ADD
  REMOVE
  RESERVATION
}

model Material {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String?
  MaterialEvent     MaterialEvent[]       @relation(name: "Event_Material")
}

model Project {
  ID                Int                   @id @default(autoincrement())
  Name              String
  Description       String?
  Customer          String?
  FinishDate        DateTime?
  Finished          Boolean
  Deleted           Boolean               @default(false)
  Owner             User                  @relation(name: "ProjectOwner", fields: [OwnerID], references: [ID])
  OwnerID           Int
  Member            User_Project[]        @relation(name: "ProjectMember")
  Task              Task[]                @relation(name: "Tasks")
  TaskDependency    TaskDependency[]      @relation(name: "Dependencies")
  ChatMessages      ChatMessage[]         @relation(name: "ProjectChat")
  ChatReads         ChatRead[]            @relation(name: "ProjectChatRead")
}

model User_Project {
  ID                Int                   @id @default(autoincrement())
  User              User                  @relation(name: "UserMember", fields: [UserID], references: [ID])
  UserID            Int
  Project           Project               @relation(name: "ProjectMember", fields: [ProjectID], references: [ID])
  ProjectID         Int
}

// Chat: a message goes either to one user (a direct message, RecipientID) or to a project's group chat (ProjectID),
// never both (a CHECK constraint in the migration). Who may read and write a project's chat: see chat.ts.
model ChatMessage {
  ID                Int                   @id @default(autoincrement())
  Sender            User                  @relation(name: "ChatSender", fields: [SenderID], references: [ID])
  SenderID          Int
  Recipient         User?                 @relation(name: "ChatRecipient", fields: [RecipientID], references: [ID], onDelete: Cascade)
  RecipientID       Int?
  Project           Project?              @relation(name: "ProjectChat", fields: [ProjectID], references: [ID], onDelete: Cascade)
  ProjectID         Int?
  Text              String
  SentAt            DateTime              @default(now())

  @@index([SenderID, RecipientID, ID])
  @@index([RecipientID, SenderID, ID])
  @@index([ProjectID, ID])
}

// How far a user has read a conversation: every message up to LastReadID. One row per user and direct-message
// partner (PartnerID) or per user and project (ProjectID).
model ChatRead {
  ID                Int                   @id @default(autoincrement())
  User              User                  @relation(name: "ChatReader", fields: [UserID], references: [ID])
  UserID            Int
  Partner           User?                 @relation(name: "ChatReadPartner", fields: [PartnerID], references: [ID], onDelete: Cascade)
  PartnerID         Int?
  Project           Project?              @relation(name: "ProjectChatRead", fields: [ProjectID], references: [ID], onDelete: Cascade)
  ProjectID         Int?
  LastReadID        Int

  @@unique([UserID, PartnerID])
  @@unique([UserID, ProjectID])
}
