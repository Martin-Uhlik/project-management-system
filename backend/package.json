{
    "name": "ad-is-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "author": "Martin Uhlik",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "prisma generate",
        "db:seed": "prisma db seed",
        "test": "vitest run",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:baseline": "prisma migrate resolve --applied 0_init"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "cors": "^2.8.6",
        "dayjs": "^1.11.23",
        "express": "^5.3.0",
        "express-fileupload": "^1.6.0",
        "pg": "^8.23.1",
        "prisma": "^7.10.1",
        "socket.io": "^4.8.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-fileupload": "^1.5.1",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
