# Settings for the whole app: cp .env.example .env
# .env is not committed. docker-compose.yml and docker-compose.dev.yml read it from this folder and pass each part
# only what it needs; npm run dev (backend and frontend) on this machine reads it too.

# PostgreSQL (the "database" service)
POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
# the database is published on 127.0.0.1 only, for npm run dev and database tools on this machine
DB_PORT=5432

# How npm run dev and the database scripts (npm run db:*) on this machine reach that database
# (inside docker compose the backend uses the host "database" instead, see docker-compose.yml)
DATABASE_URL=postgres://pms:pms@localhost:5432/pms

# The API's port, and the address the browser uses to reach it (baked into the frontend build)
BACKEND_PORT=4000
VITE_BACKEND=http://localhost:4000
# Where the frontend is opened from (comma separated). Only these may call the API from a browser.
# Open the frontend on the same host name as VITE_BACKEND (both localhost, say): the sign-in cookie only goes there.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost
# true once the app is served over HTTPS (the sign-in cookie is then sent over HTTPS only)
COOKIE_SECURE=false

# The first admin account, created by npm run db:seed when there are no users yet (admin/admin: development only)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
# Example data (users, projects, tasks, machines, material) added by npm run db:seed to a database without projects.
# docker-compose.dev.yml turns it on by default, docker-compose.yml off. Demo users sign in with the password demo1234.
SEED_DEMO_DATA=true

# Sign-in handoff from martin-uhlik.cz (backend/src/sso.ts): visitors signed in there get the demo accounts on the
# sign-in page (worker SSO_DEMO_WORKER, manager SSO_DEMO_MANAGER), one click each. SSO_PUBLIC_KEY = the issuer's Ed25519
# public key (base64 of DER, one line), SSO_ISSUER = its address. Empty = off (only the password form).
SSO_PUBLIC_KEY=
SSO_ISSUER=
SSO_DEMO_WORKER=tsvoboda
SSO_DEMO_MANAGER=jnovak
